{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote PC MCP Gateway",
  "version": "0.1.0",
  "identifier": "io.github.remotepcmcp.gateway",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Remote PC MCP Gateway",
        "width": 1020,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
